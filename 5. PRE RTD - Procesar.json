    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const a = $('Analizar Ticket').item.json;\nconst todos = ($json.detail || []).flatMap(d => d.pullRequests || []);\n\nconst prs = todos\n  .filter(p => p.source && p.source.branch === 'stage'\n            && p.destination && p.destination.branch === 'master'\n            && p.status === 'OPEN')\n  .map(p => {\n    const m = String(p.url).match(/bitbucket\\.org\\/([^/]+)\\/([^/]+)\\/pull-requests\\/(\\d+)/);\n    return {\n      repo: p.repositoryName || (m ? m[2] : ''),\n      name: p.name,\n      url: p.url,\n      api: m ? `https://api.bitbucket.org/2.0/repositories/${encodeURIComponent(m[1])}/${encodeURIComponent(m[2])}/pullrequests/${m[3]}` : null\n    };\n  })\n  .filter(p => p.api);\n\nreturn { json: { ...a, prs } };$input.item;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -96
      ],
      "id": "6e546695-eed3-4a9d-b3ef-78297aabbc9d",
      "name": "Filtrar PRs"
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "chatId": "1043602295",
        "message": "={{ (() => { const j = $json; let t = `🚀 ${j.ticket_key} en PRE RTD\\n${j.summary}\\n\\n📄 DDP: ${j.ddp_file}\\n\\n`; t += j.prs.length ? `🔀 PRs stage → master (${j.prs.length}):\\n` + j.prs.map(p => `• ${p.repo}\\n  https://bitbucket.org/${p.repo}/pull-requests/${p.api.split('/').pop()}`).join('\\n') : '🔀 Sin PRs stage → master (solo DDP)'; t += `\\n\\nSi apruebas: ${j.prs.length ? 'Approve de los PRs, ' : ''}ticket a RTD y asignado a Ariel.`; return t.replace(/([_*`\\[])/g, '\\\\$1'); })() }}",
