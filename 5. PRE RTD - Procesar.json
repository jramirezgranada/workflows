    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const t = $('When Executed by Another Workflow').item.json;\nconst issue = $json;\nconst yo = '712020:b4333890-07a2-4098-bdbf-d44ab55b58a1';\n\n// 1. Buscar el DDP a master entre los adjuntos\nconst adjuntos = (issue.fields.attachment || []).map(a => a.filename);\nconst ddp = adjuntos.find(f => /^DDP[_\\- ]?(PRD|PROD|MASTER)/i.test(f)) || null;\n\n// 2. Dev: el último (que no seas tú) que movió el ticket a CODE REVIEW; si no, el reporter\nconst hist = (issue.changelog && issue.changelog.histories) || [];\nconst movidas = hist\n  .filter(h => (h.items || []).some(i => i.field === 'status' && String(i.toString).toUpperCase() === 'CODE REVIEW'))\n  .sort((a, b) => new Date(b.created) - new Date(a.created));\nlet dev = (movidas.find(h => h.author && h.author.accountId !== yo) || {}).author;\nconst rep = issue.fields.reporter;\nif (!dev && rep && rep.accountId !== yo) dev = rep;\n\nreturn {\n  json: {\n    ticket_key: t.ticket_key,\n    summary: issue.fields.summary,\n    row_id: t.row_id,\n    issue_id: issue.id,\n    has_ddp: !!ddp,\n    ddp_file: ddp,\n    adjuntos,\n    dev_name: dev ? dev.displayName : null\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "f86f335b-76ec-4549-8cf0-d5c44006cd5a",
