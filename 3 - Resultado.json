        "jsCode": "const p = $('Preparar Desicion').first().json;\nconst bl = p.bloqueantes || [];\nif (!bl.length) return [];\nconst raw = `## 🔴 Code Review — ${bl.length} bloqueante(s)\\n\\n` +\n  bl.map((x, i) =>\n    `**${i + 1}. \\`${x.archivo}:${x.linea}\\`** — ${x.regla}\\n\\n${x.problema}` +\n    (x.solucion ? `\\n\\n**Cómo corregir:** ${x.solucion}` : '')\n  ).join('\\n\\n---\\n\\n');\nreturn [{ json: { raw } }];"
