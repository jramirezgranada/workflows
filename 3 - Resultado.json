    {
      "parameters": {
        "jsCode": "const p = $('Preparar Desicion').first().json;\nconst yo = '712020:b4333890-07a2-4098-bdbf-d44ab55b58a1';\nconst issue = $json;\nconst hist = (issue.changelog && issue.changelog.histories) || [];\n\nconst movidasACR = hist\n  .filter(h => (h.items || []).some(i => i.field === 'status' && String(i.toString).toUpperCase() === 'CODE REVIEW'))\n  .sort((a, b) => new Date(b.created) - new Date(a.created));\n\nlet dev = (movidasACR.find(h => h.author && h.author.accountId !== yo) || {}).author;\nconst rep = issue.fields && issue.fields.reporter;\nif (!dev && rep && rep.accountId !== yo) dev = rep;\n\nreturn [{ json: { ...p, dev_account_id: dev ? dev.accountId : null, dev_name: dev ? dev.displayName : null } }];"
      },
