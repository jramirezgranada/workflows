        "chatId": "1043602295",
        "message": "={{ (() => { const b = $('Webhook').item.json.body; const r = b.result || {}; const bl = r.bloqueantes || []; const sg = Array.isArray(r.sugerencias) ? r.sugerencias : []; let t = (bl.length ? `🔴 ${b.ticket_key} — ${bl.length} bloqueante(s)` : `✅ ${b.ticket_key} — sin bloqueantes`) + `\\nPR: ${r.pr_url}\\n`; if (bl.length) t += '\\n' + bl.map((x, i) => `B${i + 1}. ${x.archivo}:${x.linea}\\n${x.problema}\\n➜ ${x.solucion}`).join('\\n\\n').slice(0, 2000) + '\\n'; t += '\\n💡 Sugerencias:\\n' + (sg.map((s, i) => `S${i + 1}. ${s.archivo}:${s.linea} — ${s.detalle}`).join('\\n').slice(0, 1200) || 'Ninguna'); t += `\\n\\nSugerencia del agente: ${bl.length ? 'RECHAZAR' : 'APROBAR'}`; return t.replace(/([_*`\\[])/g, '\\\\$1'); })() }}",
        "responseType": "customForm",
        "defineForm": "json",
        "jsonOutput": "={{ (() => { const r = $('Webhook').item.json.body.result || {}; const bl = r.bloqueantes || []; const sg = Array.isArray(r.sugerencias) ? r.sugerencias : []; const f = [{ fieldLabel: 'Acción', fieldType: 'dropdown', requiredField: true, fieldOptions: { values: [{ option: 'Aprobar PR' }, { option: 'Rechazar PR' }, { option: 'Descartar' }] } }]; if (bl.length) f.push({ fieldLabel: 'Bloqueantes a reportar', fieldType: 'dropdown', multiselect: true, fieldOptions: { values: bl.map((b, i) => ({ option: `B${i + 1}. ${b.archivo}:${b.linea} — ${b.problema}`.slice(0, 150) })) } }); if (sg.length) f.push({ fieldLabel: 'Sugerencias a bloqueante', fieldType: 'dropdown', multiselect: true, fieldOptions: { values: sg.map((s, i) => ({ option: `S${i + 1}. ${s.archivo}:${s.linea} — ${s.detalle}`.slice(0, 150) })) } }); return JSON.stringify(f); })() }}",
        "options": {
