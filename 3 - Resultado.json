    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $('Webhook').item.json.body;\nconst r = b.result || {};\nconst d = $json.data || {};\nconst accion = d['Acción'] || 'Descartar';\n\n// Devuelve los índices elegidos de un campo multiselect (B1. / S1.)\nconst elegidos = (campo, letra) => {\n  let sel = d[campo] || [];\n  if (!Array.isArray(sel)) sel = [sel];\n  return sel\n    .map(o => parseInt((String(o).match(new RegExp('^' + letra + '(\\\\d+)\\\\.')) || [])[1], 10) - 1)\n    .filter(i => i >= 0);\n};\n\nconst bl = r.bloqueantes || [];\nconst sg = Array.isArray(r.sugerencias) ? r.sugerencias : [];\n\nconst bloqueantes = elegidos('Bloqueantes a reportar', 'B').filter(i => bl[i]).map(i => bl[i]);\nconst promovidas = elegidos('Sugerencias a bloqueante', 'S').filter(i => sg[i]).map(i => ({\n  archivo: sg[i].archivo,\n  linea: sg[i].linea,\n  regla: 'Promovida a bloqueante por el TL',\n  problema: sg[i].detalle,\n  solucion: ''\n}));\n\nconst m = String(r.pr_url || '').match(/bitbucket\\.org\\/([^/]+)\\/([^/]+)\\/pull-requests\\/(\\d+)/);\n\nreturn {\n  json: {\n    accion,\n    id: b.id,\n    ticket_key: b.ticket_key,\n    workspace: m ? m[1] : 'fordar',\n    repo: m ? m[2] : String(r.repo || '').split('/').pop(),\n    pr_id: m ? Number(m[3]) : Number(r.pr_id),\n    pr_url: r.pr_url,\n    has_pr: !!m,\n    bloqueantes: [...bloqueantes, ...promovidas]\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
