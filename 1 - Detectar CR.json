        "jsCode": "const key = $json.key;\nconst relaciones = ($json.fields?.issuelinks || [])\n  .filter(l => /implement/i.test(`${l.type?.inward} ${l.type?.outward}`))\n  .map(l => l.outwardIssue\n    ? `${key} implementa ${l.outwardIssue.key}`\n    : `${key} implementado por ${l.inwardIssue.key}`);\n\nreturn { json: { ...$json, has_impl: relaciones.length > 0, relaciones } };"
